{
  "about": "ACE benchmark: fixed tasks with expected results, run through the Revit bridge (no Claude needed). Run before every release with the Snowdon Towers Sample Architectural model open: node tools/bench/run.mjs. Add a case whenever a bug is fixed or a capability is added, so it can never silently break again.",
  "cases": [
    {
      "name": "Model brief finds the offices on L3-L5",
      "model": "Snowdon Towers Sample Architectural",
      "command": "model_brief",
      "args": {
        "include_families": true
      },
      "maxMs": 60000,
      "expect": [
        {
          "path": "rooms[type=Office Unit].count",
          "op": "==",
          "value": 3
        },
        {
          "path": "rooms[type=Office Unit].levels",
          "op": "contains",
          "value": "L3"
        },
        {
          "path": "families.Furniture",
          "op": "length>=",
          "value": 3
        }
      ]
    },
    {
      "name": "Family intelligence: chair footprint",
      "model": "Snowdon Towers Sample Architectural",
      "command": "describe_family",
      "args": {
        "name": "Chair-Breuer"
      },
      "maxMs": 20000,
      "expect": [
        {
          "path": "[0].footprintMm",
          "op": "exists"
        }
      ]
    },
    {
      "name": "Test fit Office 301 at 10 m2 per person",
      "model": "Snowdon Towers Sample Architectural",
      "script": "test_fit_out",
      "dryRun": true,
      "inputs": {
        "room_number": "301",
        "m2_per_person": 10
      },
      "maxMs": 20000,
      "expect": [
        {
          "path": "result.workstations",
          "op": "==",
          "value": 22
        },
        {
          "path": "result.fitsTarget",
          "op": "==",
          "value": true
        },
        {
          "path": "transaction",
          "op": "==",
          "value": "RolledBack"
        }
      ]
    },
    {
      "name": "Test fit Office 301 at 8 m2 per person reports the maximum",
      "model": "Snowdon Towers Sample Architectural",
      "script": "test_fit_out",
      "dryRun": true,
      "inputs": {
        "room_number": "301",
        "m2_per_person": 8
      },
      "maxMs": 20000,
      "expect": [
        {
          "path": "result.workstations",
          "op": "==",
          "value": 24
        },
        {
          "path": "result.fitsTarget",
          "op": "==",
          "value": false
        }
      ]
    },
    {
      "name": "Preview pictures of a change",
      "model": "Snowdon Towers Sample Architectural",
      "script": "test_fit_out",
      "dryRun": true,
      "previewImage": true,
      "inputs": {
        "room_number": "301",
        "m2_per_person": 10
      },
      "maxMs": 40000,
      "expect": [
        {
          "path": "previewImages",
          "op": "length>=",
          "value": 2
        }
      ]
    },
    {
      "name": "Door width check reads most doors",
      "model": "Snowdon Towers Sample Architectural",
      "script": "door_width_check",
      "inputs": {
        "min_width_mm": 900
      },
      "maxMs": 20000,
      "expect": [
        {
          "path": "result.doorsChecked",
          "op": ">=",
          "value": 100
        }
      ]
    },
    {
      "name": "Insights dashboard",
      "command": "get_model_insights",
      "args": {},
      "maxMs": 60000,
      "expect": [
        {
          "path": "score",
          "op": "between",
          "value": [
            0,
            100
          ]
        },
        {
          "path": "checks",
          "op": "length>=",
          "value": 15
        },
        {
          "path": "results.pass",
          "op": ">=",
          "value": 1
        },
        {
          "path": "checkSet",
          "op": "exists"
        },
        {
          "path": "checks[key=file-size].status",
          "op": "exists"
        },
        {
          "path": "checks[key=rooms-without-a-door].status",
          "op": "exists"
        }
      ]
    },
    {
      "name": "Change tracker compares without saving",
      "command": "model_changes",
      "args": {
        "save_snapshot": false
      },
      "maxMs": 180000,
      "expect": [
        {
          "path": "models",
          "op": "length>=",
          "value": 1
        }
      ]
    },
    {
      "name": "Clash tests run (all standard tests)",
      "command": "run_clash_test",
      "args": {
        "test": "all",
        "max_elements": 2000
      },
      "maxMs": 600000,
      "expect": [
        {
          "path": "tests",
          "op": "length>=",
          "value": 4
        },
        {
          "path": "topIssues",
          "op": "exists"
        },
        {
          "path": "tests[0].issues",
          "op": "exists"
        }
      ]
    },
    {
      "name": "Coordination sources",
      "command": "coordination_sources",
      "args": {},
      "maxMs": 30000,
      "expect": [
        {
          "path": "models",
          "op": "length>=",
          "value": 1
        },
        {
          "path": "standardTests",
          "op": "length>=",
          "value": 4
        }
      ]
    },
    {
      "name": "Companion panel cards are readable",
      "command": "pending_changes",
      "args": {},
      "maxMs": 5000,
      "expect": [
        {
          "path": "waiting",
          "op": "exists"
        },
        {
          "path": "note",
          "op": "exists"
        }
      ]
    },
    {
      "name": "open_view opens the room's plan",
      "model": "Snowdon Towers Sample Architectural",
      "command": "open_view",
      "args": {
        "room": "301"
      },
      "maxMs": 30000,
      "expect": [
        {
          "path": "viewType",
          "op": "==",
          "value": "FloorPlan"
        },
        {
          "path": "selected",
          "op": ">=",
          "value": 1
        }
      ]
    },
    {
      "name": "Coordination report with pictures",
      "model": "Snowdon Towers Sample Architectural",
      "command": "coordination_report",
      "args": {
        "max_issues": 3,
        "rerun": true
      },
      "maxMs": 600000,
      "expect": [
        {
          "path": "htmlReport",
          "op": "exists"
        },
        {
          "path": "excelList",
          "op": "exists"
        },
        {
          "path": "issues",
          "op": ">=",
          "value": 0
        }
      ]
    },
    {
      "name": "Clash view opens with both models in colour",
      "command": "clash_view",
      "args": {},
      "maxMs": 60000,
      "expect": [
        {
          "path": "view",
          "op": "contains",
          "value": "ACE Clash View"
        }
      ]
    },
    {
      "name": "Stored clash results load for the browser",
      "command": "clash_results",
      "args": {},
      "maxMs": 30000,
      "expect": [
        {
          "path": "clashes",
          "op": ">=",
          "value": 0
        },
        {
          "path": "issueList",
          "op": "exists"
        }
      ]
    },
    {
      "name": "Working mode can be read",
      "command": "working_mode",
      "args": {},
      "maxMs": 5000,
      "expect": [
        {
          "path": "mode",
          "op": "exists"
        },
        {
          "path": "modes",
          "op": "length>=",
          "value": 5
        }
      ]
    }
  ]
}
