<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <NoWarn>MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Build the add-in first (Release); only its plain C# change-comparison code is exercised. -->
    <Reference Include="AceRevitMcp"><HintPath>../../revit-addin/AceRevitMcp/bin/Release/net8.0-windows/AceRevitMcp.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- The ACE loader's payload selection is plain C# (no Revit): compiled in directly, so no loader build is needed. -->
    <Compile Include="../../revit-addin/AceRevitMcp.Loader/PayloadSelection.cs" Link="PayloadSelection.cs" />
  </ItemGroup>
</Project>
