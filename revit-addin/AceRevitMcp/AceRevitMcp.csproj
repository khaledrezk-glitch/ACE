<Project Sdk="Microsoft.NET.Sdk">

  <!-- One source tree, two builds: Revit 2024 runs .NET Framework 4.8 (net48), Revit 2025 runs .NET 8 (net8.0-windows).
       Build one with -f net48 or -f net8.0-windows; a plain build makes both. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>AceRevitMcp</RootNamespace>
    <AssemblyName>AceRevitMcp</AssemblyName>
    <Version>1.12.7</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <RevitVersion>2025</RevitVersion>
    <DefineConstants>$(DefineConstants);REVIT2025</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <RevitVersion>2024</RevitVersion>
    <DefineConstants>$(DefineConstants);REVIT2024</DefineConstants>
    <!-- System.Text.Json is not part of .NET Framework: it and its dependencies are shipped beside the add-in. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <!-- WPF for the ACE Companion panel. UI is written in C# (no XAML), so only the framework reference is needed;
         this also builds on non-Windows CI with EnableWindowsTargeting. Revit supplies WPF at runtime. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference-only Revit API assemblies for the target year; Revit supplies the real ones at runtime. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2024.0.0" Condition="'$(RevitVersion)' == '2024'" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2024.0.0" Condition="'$(RevitVersion)' == '2024'" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.0.2" Condition="'$(RevitVersion)' == '2025'" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.0.2" Condition="'$(RevitVersion)' == '2025'" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>
